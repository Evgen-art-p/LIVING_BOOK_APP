<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>Грондхейм | Кабинет Родителя</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,300;0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Nunito', sans-serif; }
        .orb-ring { animation: orb-pulse 3s ease-in-out infinite; }
        .orb-core { animation: core-glow 2s ease-in-out infinite; }
        @keyframes orb-pulse { 0%,100% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.06); opacity: 1; } }
        @keyframes core-glow { 0%,100% { box-shadow: 0 0 16px rgba(99,102,241,0.5); } 50% { box-shadow: 0 0 32px rgba(99,102,241,0.9); } }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .toast { position: fixed; top: 80px; left: 50%; transform: translateX(-50%); background: #6366f1; color: white; padding: 8px 20px; border-radius: 20px; font-size: 12px; font-weight: 700; z-index: 100; display: none; box-shadow: 0 4px 20px rgba(99,102,241,0.4); }
        .toast.show { display: block; animation: toast-in 0.3s ease; }
        @keyframes toast-in { from { opacity: 0; transform: translateX(-50%) translateY(-10px); } to { opacity: 1; transform: translateX(-50%) translateY(0); } }
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 2px; }
    </style>
</head>
<body class="bg-slate-50 min-h-screen text-slate-900">
<div class="max-w-6xl mx-auto p-4 md:p-8">

    <!-- ═══ HEADER ═══ -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 bg-white p-6 rounded-3xl shadow-sm border border-slate-100">
        <div>
            <p class="text-[10px] font-bold tracking-[0.25em] text-indigo-400 uppercase mb-1">Шесть Пальцев Студия</p>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Кабинет Родителя</h1>
            <p class="text-sm text-slate-400 italic">Фабрика Живых Книжек • Маяк v5.0</p>
        </div>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <!-- uid-селектор -->
            <div class="flex items-center gap-2 bg-slate-50 px-4 py-2.5 rounded-2xl border border-slate-100" id="child-selector-wrap">
                <span class="text-lg">👤</span>
                <select id="child-selector" class="bg-transparent border-none text-sm font-bold text-slate-700 focus:outline-none cursor-pointer pr-2">
                    <option value="">Загрузка…</option>
                </select>
            </div>
            <!-- Маяк-орб -->
            <div class="flex items-center gap-3 bg-slate-50 px-4 py-2.5 rounded-2xl border border-slate-100">
                <div class="orb-ring w-10 h-10 rounded-full bg-indigo-50 border border-indigo-200 flex items-center justify-center relative">
                    <div class="orb-core w-4 h-4 rounded-full bg-indigo-500" id="orb-core"></div>
                </div>
                <div>
                    <div class="text-xs font-bold text-slate-700 leading-none" id="connection-label">Проверка…</div>
                    <div class="text-[10px] text-slate-400 mt-0.5" id="connection-sub"></div>
                </div>
            </div>
            <!-- Хронос -->
            <div class="flex items-center gap-2 bg-emerald-50 px-4 py-2.5 rounded-2xl border border-emerald-100">
                <span class="relative flex h-2.5 w-2.5"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span></span>
                <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-widest">Хронос</span>
            </div>
        </div>
    </header>

    <!-- ═══ TABS ═══ -->
    <div class="flex gap-2 mb-6 bg-white p-2 rounded-2xl border border-slate-100 shadow-sm w-fit">
        <button onclick="switchTab('live')" id="btn-live" class="tab-btn px-5 py-2.5 rounded-xl text-sm font-bold tracking-wide transition-all bg-indigo-600 text-white shadow-md shadow-indigo-100">📡 Эфир</button>
        <button onclick="switchTab('memory')" id="btn-memory" class="tab-btn px-5 py-2.5 rounded-xl text-sm font-bold tracking-wide transition-all text-slate-500">📜 Память</button>
        <button onclick="switchTab('stats')" id="btn-stats" class="tab-btn px-5 py-2.5 rounded-xl text-sm font-bold tracking-wide transition-all text-slate-500">📊 Статистика</button>
        <button onclick="switchTab('server')" id="btn-server" class="tab-btn px-5 py-2.5 rounded-xl text-sm font-bold tracking-wide transition-all text-slate-500">🛠 Сервер</button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- ═══ MAIN COLUMN ═══ -->
        <div class="lg:col-span-2 space-y-6">

            <!-- ─── TAB: ЭФИР ─── -->
            <div class="tab-content active" id="tab-live">
                <!-- Семантическое Зеркало -->
                <section class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100 mb-6">
                    <h2 class="text-base font-bold mb-5 flex items-center gap-2 text-slate-800">
                        <span class="text-indigo-400 text-lg">◈</span> Семантическое Зеркало
                    </h2>
                    <div class="flex flex-wrap gap-2 mb-6" id="semantic-tags">
                        <span class="text-sm text-slate-400 italic">Нет данных — создайте первую историю</span>
                    </div>
                    <div class="p-5 bg-amber-50 rounded-2xl border border-amber-100 text-amber-900 text-sm leading-relaxed" id="bridge-tip" style="display:none">
                        <span class="font-bold mr-2">💡 Мостик в Реал:</span><span id="bridge-text"></span>
                    </div>
                </section>

                <!-- Тьютор Линк (Заказ) -->
                <section class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100 mb-6">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-base font-bold flex items-center gap-2 text-slate-800">
                            <span>🧺</span> Тьютор Линк
                        </h2>
                        <span class="text-[10px] text-slate-400 uppercase font-bold tracking-widest">Новая история</span>
                    </div>
                    <textarea id="tutor-input" class="w-full bg-slate-50 border border-slate-200 focus:border-indigo-400 focus:outline-none text-slate-800 p-4 rounded-2xl text-sm resize-none min-h-[80px] font-[Nunito]" placeholder="Опишите ситуацию: Женя боится темноты, скучает по другу..."></textarea>
                    <p class="text-xs text-indigo-600 font-semibold italic mt-2" id="tutor-hint"></p>
                    <button onclick="sendOrder()" id="btn-order" class="w-full mt-4 py-4 bg-indigo-600 text-white rounded-2xl font-bold hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100 active:scale-[0.98] text-sm tracking-wide">
                        Создать историю ✦
                    </button>
                    <div id="order-result" class="mt-4"></div>
                </section>
            </div>

            <!-- ─── TAB: ПАМЯТЬ ─── -->
            <div class="tab-content" id="tab-memory">
                <section class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100">
                    <h2 class="text-xl font-bold text-slate-900 mb-1">Хроники Грондхейма</h2>
                    <p class="text-sm text-slate-400 mb-6">Биография героя • Историческая Память</p>
                    <div id="bio-list"><div class="text-center py-10 text-slate-400 text-sm italic">Загрузка…</div></div>
                    <div class="flex flex-wrap gap-2 mt-6" id="memory-tags"></div>
                </section>
            </div>

            <!-- ─── TAB: СТАТИСТИКА ─── -->
            <div class="tab-content" id="tab-stats">
                <section class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100">
                    <h2 class="text-xl font-bold text-slate-900 mb-6">Профиль ребёнка</h2>
                    <div class="grid grid-cols-2 gap-4 mb-6" id="stats-grid">
                        <div class="text-center py-10 text-slate-400 text-sm italic col-span-2">Загрузка…</div>
                    </div>
                    <div id="growth-section"></div>
                </section>
            </div>

            <!-- ─── TAB: СЕРВЕР ─── -->
            <div class="tab-content" id="tab-server">
                <section class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100">
                    <h2 class="text-xl font-bold text-slate-900 mb-6">Маяк • Статус</h2>
                    <div id="server-info"><div class="text-center py-10 text-slate-400 text-sm italic">Загрузка…</div></div>
                </section>
            </div>
        </div>

        <!-- ═══ SIDEBAR ═══ -->
        <div class="space-y-5">
            <!-- Корзинка Даров -->
            <section class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100">
                <div class="flex justify-between items-center mb-5">
                    <h2 class="text-base font-bold flex items-center gap-2 text-slate-800"><span>🎁</span> Корзинка Даров</h2>
                </div>
                <div id="basket-content">
                    <div class="text-center py-6 text-slate-400 text-sm italic">Появится после первой истории</div>
                </div>
            </section>

            <!-- Границы Мира -->
            <section class="bg-slate-900 text-white p-8 rounded-[2rem] shadow-2xl relative overflow-hidden">
                <div class="relative z-10">
                    <h2 class="text-base font-bold mb-6 text-white">Границы Мира</h2>
                    <div class="space-y-4">
                        <div class="flex justify-between items-center text-sm">
                            <span class="text-slate-400">Сон</span>
                            <span class="text-indigo-400 font-bold">21:00 — 08:00</span>
                        </div>
                        <input type="range" class="w-full h-1 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-indigo-500">
                        <p class="text-[10px] text-slate-500 leading-relaxed uppercase tracking-wider">
                            В это время Искорка уходит в Гавань и не реагирует на внешние стимулы.
                        </p>
                    </div>
                </div>
                <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-indigo-500 opacity-10 rounded-full blur-3xl"></div>
            </section>

            <!-- Связь с Локой -->
            <button class="w-full p-6 bg-pink-50 text-pink-600 rounded-[2rem] border border-pink-100 flex items-center justify-between hover:bg-pink-100 transition-all group border-b-4 border-pink-200 active:border-b-0">
                <div class="flex items-center gap-4 text-left">
                    <span class="text-3xl animate-bounce">☁️</span>
                    <div>
                        <p class="font-bold text-pink-700 leading-none">Связь с Локой</p>
                        <p class="text-[10px] text-pink-500 uppercase mt-1 tracking-widest font-bold">Поддержка Студии</p>
                    </div>
                </div>
                <span class="text-xl group-hover:translate-x-2 transition-transform">→</span>
            </button>

            <!-- DEV: Сброс -->
            <button onclick="resetProgress()" class="w-full p-4 bg-red-50 text-red-500 rounded-2xl border border-red-100 text-xs font-bold uppercase tracking-widest hover:bg-red-100 transition-all">
                ⚠ Сброс прогресса (DEV)
            </button>

            <!-- Футер -->
            <div class="p-4 text-center">
                <p class="text-[10px] text-slate-400 uppercase tracking-widest leading-loose">
                    Шесть Пальцев Студия<br>© 2026 Грондхейм Протокол v2.0
                </p>
            </div>
        </div>
    </div>
</div>

<div class="toast" id="toast"></div>

<script>
const API = 'http://127.0.0.1:8001';

// ─── СОСТОЯНИЕ ─────────────────────────────────────────────
let CURRENT_UID = null;
let CURRENT_ALIAS = 'Женя';
let REGISTRY = null;

// ─── ТАБЫ ──────────────────────────────────────────────────
function switchTab(name) {
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('bg-indigo-600','text-white','shadow-md','shadow-indigo-100');
        b.classList.add('text-slate-500');
    });
    document.getElementById('tab-' + name).classList.add('active');
    const btn = document.getElementById('btn-' + name);
    btn.classList.remove('text-slate-500');
    btn.classList.add('bg-indigo-600','text-white','shadow-md','shadow-indigo-100');
    if (name === 'live')   { loadMirror(); loadBasket(); }
    if (name === 'memory') loadBiography();
    if (name === 'stats')  loadProfile();
    if (name === 'server') loadServerStatus();
}

function showToast(m) {
    const t = document.getElementById('toast');
    t.textContent = m;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3000);
}

// ─── REGISTRY: uid-селектор (§10, §13.4) ──────────────────
async function loadRegistry() {
    try {
        const r = await fetch(`${API}/api/registry`);
        REGISTRY = await r.json();
        const sel = document.getElementById('child-selector');
        const profiles = REGISTRY.profiles || [];

        if (profiles.length === 0) {
            sel.innerHTML = '<option value="">Нет профилей</option>';
            return;
        }

        sel.innerHTML = profiles.map(p =>
            `<option value="${p.uid}">${p.alias} (${p.uid})</option>`
        ).join('');

        // Автовыбор первого
        CURRENT_UID = profiles[0].uid;
        CURRENT_ALIAS = profiles[0].alias;
        sel.value = CURRENT_UID;

        sel.onchange = () => {
            const p = profiles.find(x => x.uid === sel.value);
            if (p) {
                CURRENT_UID = p.uid;
                CURRENT_ALIAS = p.alias;
                showToast(`Переключено на ${p.alias}`);
                loadAll();
            }
        };

        loadAll();
    } catch (e) {
        // Fallback: registry не существует → v1 mode
        console.warn('Registry не доступен, fallback на v1');
        CURRENT_UID = null;
        CURRENT_ALIAS = 'Женя';
        document.getElementById('child-selector').innerHTML =
            `<option value="">Женя (v1)</option>`;
        loadAll();
    }
}

function loadAll() {
    checkHealth();
    loadMirror();
    loadBasket();
}

// ─── FETCH HELPERS (uid → v2, fallback → v1) ──────────────
async function parentFetch(category) {
    if (CURRENT_UID) {
        const r = await fetch(`${API}/api/parent/uid/${CURRENT_UID}/${category}`);
        if (r.ok) return await r.json();
    }
    const r = await fetch(`${API}/api/parent/${category}/${encodeURIComponent(CURRENT_ALIAS)}`);
    if (r.ok) return await r.json();
    throw new Error(`${category} не найден`);
}

// ─── HEALTH ────────────────────────────────────────────────
async function checkHealth() {
    try {
        const r = await fetch(`${API}/health`);
        const h = await r.json();
        document.getElementById('connection-label').textContent = `Маяк v${h.version}`;
        document.getElementById('connection-sub').textContent = `${h.agents_available} агентов • ${h.registry_profiles || '?'} профилей`;
        document.getElementById('orb-core').classList.remove('bg-red-400');
        document.getElementById('orb-core').classList.add('bg-indigo-500');
    } catch (e) {
        document.getElementById('connection-label').textContent = 'Нет связи';
        document.getElementById('connection-sub').textContent = '';
        document.getElementById('orb-core').classList.remove('bg-indigo-500');
        document.getElementById('orb-core').classList.add('bg-red-400');
    }
}

// ─── СЕМАНТИЧЕСКОЕ ЗЕРКАЛО (§13.2) ────────────────────────
async function loadMirror() {
    try {
        const d = await parentFetch('child_profile');
        const tagEl = document.getElementById('semantic-tags');
        if (d.psychological_patterns && d.psychological_patterns.length) {
            tagEl.innerHTML = d.psychological_patterns.slice(0, 8).map(p =>
                `<span class="px-4 py-2 bg-indigo-50 text-indigo-600 rounded-2xl text-sm font-bold border border-indigo-100 italic">#${(p.split(':')[0] || p)}</span>`
            ).join('');
        } else {
            tagEl.innerHTML = '<span class="text-sm text-slate-400 italic">Паттерны появятся после первой истории</span>';
        }
    } catch (e) {
        document.getElementById('semantic-tags').innerHTML =
            '<span class="text-sm text-slate-400 italic">Нет данных — создайте первую историю</span>';
    }

    // Мостик в Реал из basket
    try {
        const d = await parentFetch('basket');
        if (d.bridge_to_reality) {
            document.getElementById('bridge-tip').style.display = 'block';
            const s = d.bridge_to_reality.conversation_starters || [];
            if (s.length) document.getElementById('bridge-text').innerHTML = `<strong>Спроси ${CURRENT_ALIAS}:</strong> ${s[0]}`;
            const a = d.bridge_to_reality.activities || [];
            if (a.length) document.getElementById('tutor-hint').textContent = `💡 ${a[0]}`;
        }
    } catch (e) { /* no basket yet */ }
}

// ─── КОРЗИНКА ДАРОВ (sidebar) ──────────────────────────────
async function loadBasket() {
    const el = document.getElementById('basket-content');
    try {
        const d = await parentFetch('basket');
        if (!d || d.error) throw 0;

        let html = '';
        if (d.parent_insights && d.parent_insights.length) {
            html += d.parent_insights.slice(0, 3).map(i =>
                `<div class="p-4 bg-violet-50 rounded-2xl border border-violet-100 mb-3 text-sm text-violet-800">🔮 ${i}</div>`
            ).join('');
        }
        if (d.bridge_to_reality?.activities?.length) {
            html += `<div class="p-4 bg-amber-50 rounded-2xl border border-amber-100 mb-3 text-sm text-amber-800">
                🎨 <strong>Активность:</strong> ${d.bridge_to_reality.activities[0]}</div>`;
        }
        if (d.next_story_hints?.suggested_theme) {
            html += `<div class="p-4 bg-emerald-50 rounded-2xl border border-emerald-100 text-sm text-emerald-800">
                🌱 <strong>Следующая тема:</strong> ${d.next_story_hints.suggested_theme}</div>`;
        }
        el.innerHTML = html || '<div class="text-center py-6 text-slate-400 text-sm italic">Корзинка пока пуста</div>';
    } catch (e) {
        el.innerHTML = '<div class="text-center py-6 text-slate-400 text-sm italic">Появится после первой истории</div>';
    }
}

// ─── ЗАКАЗ ИСТОРИИ ─────────────────────────────────────────
async function sendOrder() {
    const input = document.getElementById('tutor-input');
    const msg = input.value.trim();
    if (!msg) { showToast('Заполните задачу!'); return; }
    const btn = document.getElementById('btn-order');
    const res = document.getElementById('order-result');

    btn.disabled = true;
    btn.textContent = 'Создаю… 2-5 мин';
    res.innerHTML = '<div class="p-6 bg-indigo-50 rounded-2xl border border-indigo-100 text-center"><div class="text-3xl mb-3 animate-pulse">✨</div><p class="text-sm text-indigo-700 font-bold">18 агентов работают…</p></div>';

    try {
        const body = {
            child_name: CURRENT_ALIAS,
            child_age: '7-12',
            task_context: msg,
        };
        if (CURRENT_UID) body.uid = CURRENT_UID;

        const r = await fetch(`${API}/api/studio/generate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
        });
        if (!r.ok) {
            const e = await r.json().catch(() => ({}));
            throw new Error(e.detail || `Ошибка ${r.status}`);
        }
        const d = await r.json();
        showToast(`Готово! ${d.agents_completed} агентов.`);
        res.innerHTML = `<div class="p-6 bg-emerald-50 rounded-2xl border border-emerald-100 text-center">
            <div class="text-3xl mb-3">🎉</div>
            <p class="text-sm text-emerald-700 font-bold">История для «${d.child_name}» создана!</p>
            <p class="text-xs text-emerald-600 mt-2">${d.agents_completed} агентов отработали • uid: ${d.uid || '—'}</p>
        </div>`;
        input.value = '';
        // Обновляем данные
        if (d.uid && !CURRENT_UID) {
            CURRENT_UID = d.uid;
            loadRegistry(); // перезагрузить список
        }
        loadMirror();
        loadBasket();
    } catch (e) {
        console.error(e);
        res.innerHTML = `<div class="p-6 bg-red-50 rounded-2xl border border-red-100 text-center">
            <p class="text-sm text-red-700 font-bold">Ошибка: ${e.message}</p>
            <p class="text-xs text-red-500 mt-2">Проверьте: <code>cd server && uvicorn beacon_v4:app --port 8001</code></p>
        </div>`;
    }
    btn.disabled = false;
    btn.textContent = 'Создать историю ✦';
}

// ─── БИОГРАФИЯ (§12) ──────────────────────────────────────
async function loadBiography() {
    const list = document.getElementById('bio-list');
    const tags = document.getElementById('memory-tags');
    try {
        const d = await parentFetch('biography');
        if (!d || !d.karmic_trail || !d.karmic_trail.length) {
            list.innerHTML = '<div class="text-center py-10 text-slate-400 text-sm italic">Биография появится после первой истории.</div>';
            return;
        }

        let h = `<div class="flex gap-3 mb-6">
            <div class="px-4 py-2 bg-indigo-50 text-indigo-600 rounded-2xl text-sm font-bold border border-indigo-100">📚 ${d.total_stories || 0} историй</div>
            <div class="px-4 py-2 bg-violet-50 text-violet-600 rounded-2xl text-sm font-bold border border-violet-100">👥 ${Object.keys(d.character_bonds || {}).length} персонажей</div>
            ${d.memory_depth ? `<div class="px-4 py-2 bg-amber-50 text-amber-600 rounded-2xl text-sm font-bold border border-amber-100">🧠 ${d.memory_depth}</div>` : ''}
        </div>`;

        h += d.karmic_trail.slice().reverse().map(t => `
            <div class="flex items-start gap-4 p-5 rounded-2xl border border-slate-100 bg-white mb-3 shadow-sm">
                <div class="text-xl">📜</div>
                <div class="flex-1">
                    <p class="text-sm text-slate-700 font-bold">${t.theme || 'Глава'}</p>
                    <p class="text-xs text-slate-500 mt-1">${t.task_context || t.emotional_goal || ''}</p>
                    <div class="flex flex-wrap gap-1 mt-2">
                        ${(t.characters_met || []).map(c => `<span class="text-[10px] px-2 py-0.5 bg-violet-50 text-violet-500 rounded-lg border border-violet-100">${c}</span>`).join('')}
                        ${(t.choices_made || []).map(c => `<span class="text-[10px] px-2 py-0.5 bg-indigo-50 text-indigo-500 rounded-lg border border-indigo-100">${c.choice_id || c.label || c}</span>`).join('')}
                    </div>
                    <p class="text-[10px] text-slate-400 mt-2">${t.date ? new Date(t.date).toLocaleDateString('ru') : ''}</p>
                </div>
            </div>
        `).join('');
        list.innerHTML = h;

        // Персонажи
        if (d.character_bonds) {
            tags.innerHTML = Object.entries(d.character_bonds)
                .sort((a, b) => b[1] - a[1])
                .map(([c, n]) => `<span class="px-4 py-2 bg-violet-50 text-violet-600 rounded-2xl text-sm font-semibold border border-violet-100">👤 ${c} (×${n})</span>`)
                .join('');
        }
    } catch (e) {
        list.innerHTML = '<div class="text-center py-10 text-slate-400 text-sm italic">Биография появится после первой истории.</div>';
    }
}

// ─── ПРОФИЛЬ / СТАТИСТИКА ─────────────────────────────────
async function loadProfile() {
    const grid = document.getElementById('stats-grid');
    const growth = document.getElementById('growth-section');
    try {
        const d = await parentFetch('child_profile');
        grid.innerHTML = [
            { l: 'Сессии', v: d.total_sessions || 0, i: '🕯' },
            { l: 'Выборы', v: d.total_choices_made || 0, i: '🔀' },
            { l: 'Паттерны', v: (d.psychological_patterns || []).length, i: '🧠' },
            { l: 'Персонажи', v: Object.keys(d.character_bonds || {}).length, i: '👥' },
        ].map(s => `
            <div class="p-6 rounded-2xl border border-slate-100 bg-slate-50 text-center">
                <div class="text-3xl mb-2">${s.i}</div>
                <div class="text-3xl font-bold text-slate-800">${s.v}</div>
                <div class="text-[10px] text-slate-400 uppercase font-bold tracking-widest mt-1">${s.l}</div>
            </div>
        `).join('');

        growth.innerHTML = '';
        if (d.growth_zones && d.growth_zones.length) {
            growth.innerHTML = `<div class="mt-6">
                <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Зоны роста</h3>
                ${d.growth_zones.slice(0, 5).map(z => `
                    <div class="flex items-center gap-3 p-4 rounded-2xl border border-emerald-100 bg-emerald-50 mb-2">
                        <span class="text-xl">🌱</span>
                        <span class="text-sm font-semibold text-emerald-800">${(z.split(':')[0] || z)}</span>
                    </div>
                `).join('')}
            </div>`;
        }
    } catch (e) {
        grid.innerHTML = '<div class="col-span-2 text-center py-10 text-slate-400 text-sm italic">Профиль появится после первой истории.</div>';
    }
}

// ─── СЕРВЕР ───────────────────────────────────────────────
async function loadServerStatus() {
    const el = document.getElementById('server-info');
    try {
        const [health, stats] = await Promise.all([
            fetch(`${API}/health`).then(r => r.json()),
            fetch(`${API}/stats`).then(r => r.json()),
        ]);
        el.innerHTML = `
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="p-5 rounded-2xl bg-emerald-50 border border-emerald-100 text-center">
                    <div class="text-2xl mb-1">✅</div>
                    <div class="text-sm font-bold text-emerald-700">${health.status}</div>
                    <div class="text-[10px] text-emerald-600 mt-1">v${health.version} • ${health.protocol || '—'}</div>
                </div>
                <div class="p-5 rounded-2xl bg-indigo-50 border border-indigo-100 text-center">
                    <div class="text-2xl mb-1">🤖</div>
                    <div class="text-sm font-bold text-indigo-700">${health.agents_available} агентов</div>
                    <div class="text-[10px] text-indigo-600 mt-1">${health.model}</div>
                </div>
                <div class="p-5 rounded-2xl bg-violet-50 border border-violet-100 text-center">
                    <div class="text-2xl mb-1">📖</div>
                    <div class="text-sm font-bold text-violet-700">${stats.total_generated_books} книг</div>
                    <div class="text-[10px] text-violet-600 mt-1">создано</div>
                </div>
                <div class="p-5 rounded-2xl bg-amber-50 border border-amber-100 text-center">
                    <div class="text-2xl mb-1">🆔</div>
                    <div class="text-sm font-bold text-amber-700">${stats.total_profiles || health.registry_profiles || 0} профилей</div>
                    <div class="text-[10px] text-amber-600 mt-1">в реестре</div>
                </div>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
                <div class="text-xs text-slate-500 space-y-2">
                    <p><strong>API ключ:</strong> ${health.api_key_set ? '✅ Установлен' : '❌ Отсутствует'}</p>
                    <p><strong>Студия:</strong> ${health.studio_root || '—'}</p>
                    <p><strong>Книги:</strong> ${health.books_dir || '—'}</p>
                    <p><strong>Устройств:</strong> ${stats.total_devices} • Синхронизаций: ${stats.total_syncs}</p>
                </div>
            </div>`;
    } catch (e) {
        el.innerHTML = `<div class="p-6 bg-red-50 rounded-2xl border border-red-100 text-center">
            <p class="text-sm text-red-700 font-bold">Маяк недоступен</p>
            <p class="text-xs text-red-500 mt-2">Запустите: <code>cd server && uvicorn beacon_v4:app --port 8001</code></p>
        </div>`;
    }
}

// ─── СБРОС (DEV) ──────────────────────────────────────────
function resetProgress() {
    if (!confirm('Сбросить прогресс IndexedDB?')) return;
    indexedDB.deleteDatabase('iskra_fort').onsuccess = () => showToast('Прогресс сброшен');
}

// ─── СТАРТ ────────────────────────────────────────────────
loadRegistry();
setInterval(checkHealth, 15000);
</script>
</body>
</html>
