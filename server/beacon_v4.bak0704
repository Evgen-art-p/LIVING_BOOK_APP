def get_age_paradigm(child_name: str, uid: Optional[str] = None) -> str:
    """
    Определяет возрастную парадигму для ребёнка.
    Читает age_group из child_profile.json или registry.json.
    Возвращает system_addon для подмешивания в промпт LLM.
    """
    age_group = "7-12"  # default

    # 1. Пробуем child_profile.json
    folder = None
    if uid:
        folder = resolve_uid(uid)
    if not folder:
        folder = _find_child_folder(child_name)

    if folder:
        profile_path = folder / "child_profile.json"
        if profile_path.exists():
            try:
                profile = json.loads(profile_path.read_text(encoding="utf-8"))
                ag = profile.get("age_group") or profile.get("sessions", [{}])[0].get("age_group")
                if ag:
                    age_group = ag
            except:
                pass

    # 2. Fallback: registry.json
    if age_group == "7-12" and uid:
        p = get_profile_by_uid(uid)
        if p and p.get("age_group"):
            age_group = p["age_group"]

    # 3. Ищем подходящую парадигму
    paradigm = AGE_PARADIGMS.get(age_group)
    if not paradigm:
        # Ищем ближайшую
        for key in AGE_PARADIGMS:
            if age_group in key or key in age_group:
                paradigm = AGE_PARADIGMS[key]
                break
    if not paradigm:
        paradigm = AGE_PARADIGMS["7-12"]

    print(f"[AGE DNA] {child_name}: {age_group} → {paradigm['name']}")
    return paradigm["system_addon"]


# ═══════════════════════════════════════════════════════════════════════════════
# РЕЕСТР СУДЕБ (REGISTRY) — §10
# ═══════════════════════════════════════════════════════════════════════════════

def load_registry() -> dict:
    if REGISTRY_PATH.exists():
        return json.loads(REGISTRY_PATH.read_text(encoding="utf-8"))
    empty = {"version": "1.0", "updated_at": datetime.now().isoformat(), "profiles": []}
    save_registry(empty)
    return empty

def save_registry(registry: dict):
    registry["updated_at"] = datetime.now().isoformat()
    REGISTRY_PATH.write_text(json.dumps(registry, ensure_ascii=False, indent=2), encoding="utf-8")

def generate_uid() -> str:
    today = datetime.now().strftime("%Y-%m-%d")
    registry = load_registry()
    today_count = sum(1 for p in registry["profiles"] if p["uid"].startswith(f"LB-{today}"))
    return f"LB-{today}-{today_count + 1:04d}"

def resolve_uid(uid: str) -> Optional[Path]:
    registry = load_registry()
    for profile in registry.get("profiles", []):
        if profile["uid"] == uid:
            folder = BOOKS_DIR / profile["folder"]
            if folder.exists(): return folder
    return None

def get_profile_by_uid(uid: str) -> Optional[dict]:
    registry = load_registry()
    for profile in registry.get("profiles", []):
        if profile["uid"] == uid: return profile
    return None

def find_uid_by_name(child_name: str) -> Optional[str]:
    registry = load_registry()
    target = child_name.lower()
    for profile in registry.get("profiles", []):
        if profile.get("alias", "").lower() == target: return profile["uid"]
        if profile.get("folder", "").lower() == target: return profile["uid"]
    return None

def ensure_registry_entry(child_name: str, age_group: str = "7-12") -> str:
    existing_uid = find_uid_by_name(child_name)
    if existing_uid: return existing_uid
    uid = generate_uid()
    registry = load_registry()
    folder = child_name
    child_dir = _find_child_folder(child_name)
    if child_dir: folder = child_dir.name
    registry["profiles"].append({
        "uid": uid, "alias": child_name, "folder": folder,
        "age_group": age_group, "created_at": datetime.now().strftime("%Y-%m-%d"),
        "last_activity": datetime.now().isoformat(),
        "history_file": "biography.json", "device_ids": [], "status": "active",
    })
    save_registry(registry)
    print(f"[REGISTRY] ✅ {uid} → {folder} ({child_name})")
    return uid

def update_last_activity(uid: str):
    registry = load_registry()
    for p in registry.get("profiles", []):
        if p["uid"] == uid:
            p["last_activity"] = datetime.now().isoformat()
            save_registry(registry)
            return


# ═══════════════════════════════════════════════════════════════════════════════
# BIOGRAPHY + LIVE MEMORY — §12, v5.1
# ═══════════════════════════════════════════════════════════════════════════════

def _load_bio(folder: Path, uid: str, alias: str = "Ребёнок") -> dict:
    bio_path = folder / "biography.json"
    if bio_path.exists():
        bio = json.loads(bio_path.read_text(encoding="utf-8"))
    else:
        bio = {"uid": uid, "child_name": alias, "created_at": datetime.now().isoformat(),
               "updated_at": datetime.now().isoformat(), "total_stories": 0,
               "memory_depth": "infinite", "karmic_trail": [], "character_bonds": {},
               "world_knowledge": [], "emotional_milestones": [],
               "psychological_patterns": [], "live_dialogues": []}
    bio.setdefault("uid", uid)
    bio.setdefault("memory_depth", "infinite")
    bio.setdefault("live_dialogues", [])
    return bio

def _save_bio(folder: Path, bio: dict):
    bio["updated_at"] = datetime.now().isoformat()
    bio["total_stories"] = len(bio.get("karmic_trail", []))
    (folder / "biography.json").write_text(json.dumps(bio, ensure_ascii=False, indent=2), encoding="utf-8")

def update_biography(uid: str, entry: dict):
    folder = resolve_uid(uid)
    if not folder: return
    profile = get_profile_by_uid(uid)
    alias = profile.get("alias", "Ребёнок") if profile else "Ребёнок"
    bio = _load_bio(folder, uid, alias)
    bio["karmic_trail"].append(entry)
    for char in entry.get("characters_met", []):
        bio["character_bonds"][char] = bio["character_bonds"].get(char, 0) + 1
    _save_bio(folder, bio)

def append_choices_to_biography(uid: str, choices: list, tags: list):
    folder = resolve_uid(uid)
    if not folder: return
    profile = get_profile_by_uid(uid)
    bio = _load_bio(folder, uid, profile.get("alias", "") if profile else "")
    if not bio.get("karmic_trail"): return
    last = bio["karmic_trail"][-1]
    existing = last.get("choices_made", [])
    existing.extend([{"choice_id": c, "source": "nightbeacon"} for c in choices])
    last["choices_made"] = existing
    for tag in tags:
        if tag not in bio.get("psychological_patterns", []):
            bio.setdefault("psychological_patterns", []).append(tag)
    _save_bio(folder, bio)

def live_record_dialogue(child_name: str, uid: Optional[str], scene_id: str,
                         child_text: str, ai_text: str):
    folder = resolve_uid(uid) if uid else _find_child_folder(child_name)
    if not folder: return
    resolved_uid = uid or find_uid_by_name(child_name) or "unknown"
    profile = get_profile_by_uid(resolved_uid) if resolved_uid != "unknown" else None
    bio = _load_bio(folder, resolved_uid, profile.get("alias", child_name) if profile else child_name)
    bio["live_dialogues"].append({
        "ts": datetime.now().isoformat(), "scene_id": scene_id,
        "child_said": child_text[:200], "iskra_said": ai_text[:200],
    })
    if len(bio["live_dialogues"]) > 500:
        bio["live_dialogues"] = bio["live_dialogues"][-500:]
    KNOWN_CHARS = ["искорка", "эйрик", "лока", "петя", "петей"]
    text_lower = child_text.lower()
    for cn in KNOWN_CHARS:
        if cn in text_lower:
            norm = cn.capitalize().replace("Петей", "Петя")
            bio["character_bonds"][norm] = bio["character_bonds"].get(norm, 0) + 1
    _save_bio(folder, bio)
    print(f"[LIVE] 📝 {child_name} в {scene_id}: «{child_text[:40]}»")

def ensure_basket(child_name: str, uid: Optional[str], scene_id: str, ai_text: str):
    folder = resolve_uid(uid) if uid else _find_child_folder(child_name)
    if not folder: return
    basket_path = folder / "basket.json"
    if basket_path.exists(): return
    basket = {
        "created_at": datetime.now().isoformat(),
        "story_theme": "Сад Памяти", "task_context": "Диалог с Искоркой",
        "parent_insights": ["Ребёнок активно взаимодействует с Искоркой",
                            "Диалог идёт через голосовой интерфейс"],
        "bridge_to_reality": {
            "conversation_starters": [
                f"Спроси у {child_name}: что тебе сегодня рассказала Искорка?",
                "Попробуйте вместе вспомнить любимый момент дня.",
            ],
            "activities": [
                "Нарисуйте вместе Сад Памяти — каждый цветок = одно воспоминание",
                "Перед сном вспомните 3 хороших момента за день",
            ],
        },
        "next_story_hints": {"suggested_theme": "Дружба и новые знакомства"},
    }
    basket_path.write_text(json.dumps(basket, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"[BASKET] ✅ Создан для {child_name}")


# ═══════════════════════════════════════════════════════════════════════════════
# УТИЛИТЫ
# ═══════════════════════════════════════════════════════════════════════════════

def load_agent_prompt(agent_id: str) -> str:
    for pp in [MODULES_PATH / agent_id / "forge" / "prompt.md", MODULES_PATH / agent_id / "prompt.md"]:
        if pp.exists(): return pp.read_text(encoding="utf-8")
    return f"Ты агент {agent_id}. Выполни задачу качественно."

def load_agent_anchor(agent_id: str) -> str:
    ap = MODULES_PATH / agent_id / "core" / "anchor_points.md"
    return ap.read_text(encoding="utf-8") if ap.exists() else ""

async def call_openrouter(system_prompt: str, user_prompt: str,
                           max_tokens: int = 4000, temperature: float = 0.7) -> str:
    if not OPENROUTER_API_KEY: raise HTTPException(500, "OPENROUTER_API_KEY не задан")
    async with httpx.AsyncClient(timeout=120.0) as client:
        r = await client.post(OPENROUTER_URL,
            headers={"Authorization": f"Bearer {OPENROUTER_API_KEY}", "Content-Type": "application/json",
                     "HTTP-Referer": "https://grondheim.local", "X-Title": "Living Book Grondheim"},
            json={"model": OPENROUTER_MODEL, "max_tokens": max_tokens, "temperature": temperature,
                  "messages": [{"role": "system", "content": system_prompt}, {"role": "user", "content": user_prompt}]})
        r.raise_for_status()
        return r.json()["choices"][0]["message"]["content"].strip()

def extract_json_from_response(raw: str) -> dict:
    for pattern in [r"SYSTEM_JSON_START\s*(.*?)\s*SYSTEM_JSON_END", r"```json\s*(.*?)\s*```"]:
        m = re.search(pattern, raw, re.DOTALL)
        if m:
            try: return json.loads(m.group(1).strip())
            except: pass
    for start in [raw.find("{"), raw.find("[")]:
        if start >= 0:
            try: return json.loads(raw[start:])
            except: pass
    return {}

def _find_child_folder(name: str) -> Optional[Path]:
    if not BOOKS_DIR.exists(): return None
    for d in BOOKS_DIR.iterdir():
        if d.is_dir() and d.name.lower() == name.lower(): return d
    return None

def _find_book_path(child_name: str) -> Optional[Path]:
    for p in [BOOKS_DIR / child_name / "book.json", BOOKS_DIR / child_name.lower() / "book.json",
              BOOKS_DIR / child_name.lower().replace(" ", "_") / "book.json"]:
        if p.exists(): return p
    if BOOKS_DIR.exists():
        t = child_name.lower().replace(" ", "_")
        for e in BOOKS_DIR.iterdir():
            if e.is_dir() and e.name.lower().replace(" ", "_") == t:
                p = e / "book.json"
                if p.exists(): return p
    return None

def _find_book_path_by_uid(uid: str) -> Optional[Path]:
    folder = resolve_uid(uid)
    if folder:
        bp = folder / "book.json"
        if bp.exists(): return bp
    return None

def _find_stories_folder(child_name: str) -> Optional[Path]:
    sr = BASE_DIR / "stories"
    if not sr.exists(): return None
    for candidate in [sr / child_name, sr / child_name.lower().replace(" ", "_")]:
        if candidate.exists(): return candidate
    t = child_name.lower().replace(" ", "_")
    for e in sr.iterdir():
        if e.is_dir() and e.name.lower().replace(" ", "_") == t: return e
    return None


# ═══════════════════════════════════════════════════════════════════════════════
# SET + ПАЙПЛАЙН
# ═══════════════════════════════════════════════════════════════════════════════

SET_SYSTEM_PROMPT = """Ты — Сет, Главный оркестратор студии SIX FINGERS.
Серверный диспетчер-робот. Принимаешь данные → формируешь MASTER BRIEF.
Цех: living_book. Следующий: A00 (Фабула Фейн). Ты НЕ пишешь истории.
ОБЯЗАТЕЛЬНО: creative_soul (feel, world, forbidden, purpose).
Формат: между тегами SYSTEM_JSON_START и SYSTEM_JSON_END."""

PIPELINE_AGENTS = ["A01","A02","A03","A04","A05","A06","A07","A08",
                   "A09","A10","A11","A12","A13","A14","A15","A16"]
MAX_REVISION_LOOPS = 3

async def run_genesis(master_brief: dict) -> tuple[str, dict]:
    brief_json = json.dumps(master_brief, ensure_ascii=False, indent=2)
    revision_notes = ""
    for loop in range(MAX_REVISION_LOOPS):
        a00_prompt = load_agent_prompt("A00")
        a00_anchor = load_agent_anchor("A00")
        ctx = f"MASTER BRIEF:\n{brief_json}\n"
        if revision_notes: ctx += f"\n⚠️ ЗАМЕЧАНИЯ:\n{revision_notes}\n"
        if a00_anchor: ctx = a00_anchor + "\n\n" + ctx
        print(f"  [GENESIS] A00 (петля {loop+1})...")
        a00_raw = await call_openrouter(a00_prompt, ctx)
        a00a_prompt = load_agent_prompt("A00a")
        a00a_anchor = load_agent_anchor("A00a")
        a00a_ctx = f"РЕЗУЛЬТАТ:\n{a00_raw}\n\nBRIEF:\n{brief_json}"
        if a00a_anchor: a00a_ctx = a00a_anchor + "\n\n" + a00a_ctx
        a00a_raw = await call_openrouter(a00a_prompt, a00a_ctx)
        a00a_meta = extract_json_from_response(a00a_raw)
        mo = a00a_meta.get("my_output", a00a_meta)
        if "APPROVED" in mo.get("verdict", "APPROVED").upper():
            return a00_raw, a00a_meta
        revision_notes = mo.get("revision_notes", "")
        recs = mo.get("recommendations", [])
        if recs: revision_notes += "\n" + "\n".join(f"{i+1}. {r}" for i, r in enumerate(recs))
    return a00_raw, {"my_output": {"verdict": "APPROVED_WITH_NOTES"}}

async def run_full_pipeline(master_brief: dict) -> dict:
    results = {}
    a00_raw, a00a_meta = await run_genesis(master_brief)
    results["A00"] = a00_raw; results["A00a"] = a00a_meta
    chain = f"--- A00 ---\n{a00_raw[:3000]}\n--- A00a ---\n{a00a_meta.get('my_output',{}).get('verdict','OK')}\n"
    for aid in PIPELINE_AGENTS:
        prompt = load_agent_prompt(aid)
        if prompt.startswith("Ты агент") and len(prompt) < 100:
            results[aid] = {"status": "stub"}; continue
        print(f"  [PIPELINE] {aid}...")
        try:
            anchor = load_agent_anchor(aid)
            ctx = (anchor + "\n\n" if anchor else "") + f"BRIEF:\n{json.dumps(master_brief, ensure_ascii=False, indent=2)}\n\nПРЕДЫДУЩИЕ:\n{chain[-6000:]}\n"
            raw = await call_openrouter(prompt, ctx, max_tokens=4000)
            results[aid] = raw
            meta = extract_json_from_response(raw)
            mo = meta.get("my_output", {})
            chain += f"\n--- {aid} ---\n{json.dumps(mo, ensure_ascii=False)[:1500] if mo else raw[:1000]}\n"
        except Exception as e:
            results[aid] = {"status": "error", "error": str(e)}
    return results

def extract_book_package(results: dict) -> dict:
    a16 = results.get("A16", "")
    if isinstance(a16, dict): return a16
    pkg = {}
    for fn, content in re.findall(r'### === FILE:\s*(.+?)\s*===\s*\n```json\s*\n(.*?)\n```', a16, re.DOTALL):
        try: pkg[fn.strip()] = json.loads(content)
        except: pkg[fn.strip()] = content
    if not pkg:
        meta = extract_json_from_response(a16)
        if meta: pkg = meta
    return pkg

def save_book_package(uid: str, child_name: str, package: dict, master_brief: dict) -> Path:
    folder = resolve_uid(uid) or BOOKS_DIR / child_name.lower().replace(" ", "_")
    folder.mkdir(parents=True, exist_ok=True)
    for fn, content in package.items():
        fp = folder / fn; fp.parent.mkdir(parents=True, exist_ok=True)
        if isinstance(content, (dict, list)):
            if fn == "book.json" and isinstance(content, dict): content["uid"] = uid
            fp.write_text(json.dumps(content, ensure_ascii=False, indent=2), encoding="utf-8")
        else: fp.write_text(str(content), encoding="utf-8")
    (folder / "_master_brief.json").write_text(json.dumps(master_brief, ensure_ascii=False, indent=2), encoding="utf-8")
    profile = get_profile_by_uid(uid)
    pk = profile["folder"].lower().replace(" ", "_") if profile else child_name.lower().replace(" ", "_")
    pd = BASE_DIR / "stories" / pk; pd.mkdir(parents=True, exist_ok=True)
    (pd / f"story_{datetime.now().strftime('%Y%m%d_%H%M%S')}_pending.json").write_text(
        json.dumps(package, ensure_ascii=False, indent=2), encoding="utf-8")
    return folder


# ═══════════════════════════════════════════════════════════════════════════════
# ЭНДПОИНТЫ — СХЕМЫ
# ═══════════════════════════════════════════════════════════════════════════════

class GenerateRequest(BaseModel):
    child_name: str
    child_age: Optional[str] = "7-12"
    task_context: str
    uid: Optional[str] = None

class FreeTalkRequest(BaseModel):
    child_text: str
    scene_id: str
    chapter_id: str = ""
    child_name: str = "Ребёнок"
    uid: Optional[str] = None
    session_id: str = ""

class AddChildRequest(BaseModel):
    name: str
    age_group: str = "7-12"
    personality: Optional[str] = None  # "active", "quiet", "curious"

class BeaconEvent(BaseModel):
    type: str
    ts: int
    choice_id: Optional[str] = None
    tag: Optional[str] = None

class BeaconBatch(BaseModel):
    device_id: str
    session_id: str
    synced_at: str
    uid: Optional[str] = None
    events: list[BeaconEvent]
    llm_stats: Optional[dict] = None


