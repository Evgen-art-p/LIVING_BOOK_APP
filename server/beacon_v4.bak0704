    import uvicorn
    registry = load_registry()
    print("🚀 Живая Книга — Сервер v5.2 (Возрастная ДНК)")
    print(f"🤖 {OPENROUTER_MODEL} | 📖 {BOOKS_DIR} | 🆔 {len(registry.get('profiles',[]))} профилей")
    if PLAYER_DIR.exists():
        print(f"📺 Искорка:  http://127.0.0.1:8001/player/index.html")
    if DASHBOARD_DIR.exists():
        print(f"📊 Кабинет:  http://127.0.0.1:8001/dashboard/index.html")
    print("⚠️  НЕ используй Live Server (порт 5500) — он перезагружает Искорку!")
    uvicorn.run(app, host="0.0.0.0", port=8001)
