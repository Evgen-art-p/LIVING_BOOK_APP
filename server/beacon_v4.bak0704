@app.get("/api/registry")
async def get_registry():
    return load_registry()

@app.get("/api/registry/{uid}")
async def get_registry_profile(uid: str):
    profile = get_profile_by_uid(uid)
    if not profile: raise HTTPException(404, f"Профиль {uid} не найден")
    return profile

@app.post("/api/registry/add_child")
async def add_child(req: AddChildRequest):
    """
    v5.2: Создание нового профиля ребёнка из Кабинета Родителя.
    Создаёт: запись в registry.json + папку + child_profile.json + biography.json
    """
    # Проверяем нет ли уже
    existing = find_uid_by_name(req.name)
    if existing:
        return {"ok": True, "uid": existing, "message": "Профиль уже существует", "created": False}

    uid = ensure_registry_entry(req.name, req.age_group)

    # Создаём папку и базовые файлы
    folder = resolve_uid(uid)
    if not folder:
        folder = BOOKS_DIR / req.name
        folder.mkdir(parents=True, exist_ok=True)

    # child_profile.json
    profile_data = {
        "child_name": req.name,
        "created_at": datetime.now().isoformat(),
        "age_group": req.age_group,
        "personality": req.personality or "curious",
        "total_sessions": 0,
        "total_choices_made": 0,
        "psychological_patterns": [],
        "growth_zones": [],
        "sessions": [],
        "updated_at": datetime.now().isoformat(),
    }
    (folder / "child_profile.json").write_text(
        json.dumps(profile_data, ensure_ascii=False, indent=2), encoding="utf-8")

    # biography.json
    bio = _load_bio(folder, uid, req.name)
    _save_bio(folder, bio)

    # chapters/
    (folder / "chapters").mkdir(exist_ok=True)
    (folder / "characters").mkdir(exist_ok=True)

    print(f"[ADD_CHILD] ✅ {req.name} ({req.age_group}) → uid={uid}")

    return {
        "ok": True,
        "uid": uid,
        "name": req.name,
        "age_group": req.age_group,
        "folder": str(folder),
        "created": True,
    }


# ═══════════════════════════════════════════════════════════════════════════════
# ГЕНЕРАЦИЯ КНИГИ
# ═══════════════════════════════════════════════════════════════════════════════

@app.post("/api/studio/generate")
async def generate_book(req: GenerateRequest):
    print(f"\n{'='*60}\n📖 ЗАКАЗ: {req.child_name}, {req.child_age}, {req.task_context}\n{'='*60}")
    uid = req.uid or ensure_registry_entry(req.child_name, req.child_age or "7-12")
    print(f"  🆔 uid: {uid}")
    set_raw = await call_openrouter(SET_SYSTEM_PROMPT,
        f"Ребёнок: {req.child_name}, {req.child_age}. Задача: {req.task_context}", max_tokens=800)
    master_brief = extract_json_from_response(set_raw)
    if not master_brief: raise HTTPException(422, f"SET fail: {set_raw[:300]}")
    master_brief.setdefault("child_name", req.child_name)
    master_brief.setdefault("child_age", req.child_age)
    master_brief.setdefault("task_context", req.task_context)
    master_brief["uid"] = uid
    results = await run_full_pipeline(master_brief)
    package = extract_book_package(results)
    book_dir = save_book_package(uid, req.child_name, package, master_brief) if package else None
    update_biography(uid, {
        "date": datetime.now().isoformat(),
        "story_id": f"story_{datetime.now().strftime('%Y%m%d_%H%M%S')}",
        "theme": master_brief.get("theme", ""), "task_context": master_brief.get("task_context", ""),
        "emotional_goal": master_brief.get("emotional_goal", ""), "characters_met": [],
        "choices_made": [], "key_message": master_brief.get("purpose", ""),
        "world": master_brief.get("world", ""),
    })
    update_last_activity(uid)
    with sqlite3.connect(BEACON_DB) as conn:
        conn.execute("INSERT INTO generated_scenes (child_name,child_age,task_context,set_brief,generated_at,file_path) VALUES (?,?,?,?,?,?)",
            (req.child_name, req.child_age, req.task_context, json.dumps(master_brief, ensure_ascii=False),
             datetime.now().isoformat(), str(book_dir) if book_dir else ""))
    print(f"🎉 ГОТОВО! uid={uid}\n")
    return {"ok": True, "uid": uid, "child_name": req.child_name,
            "book_dir": str(book_dir) if book_dir else None,
            "agents_completed": len([r for r in results.values() if not (isinstance(r, dict) and r.get("status") in ("stub","error"))]),
            "master_brief": master_brief}


# ═══════════════════════════════════════════════════════════════════════════════
# FREE TALK — v5.2: ВОЗРАСТНАЯ ДНК + ЖИВАЯ ЗАПИСЬ
# ═══════════════════════════════════════════════════════════════════════════════

SAFETY_KEYWORDS = ["помогите", "спасите", "умереть", "убить", "кровь", "наркотик", "секс", "порно"]

@app.post("/api/free_talk")
async def free_talk(req: FreeTalkRequest):
    """
    v5.2: Динамический промпт по возрасту + живая запись в biography.
    Маяк читает age_group → подмешивает возрастную парадигму в system prompt.
    """
    text_lower = req.child_text.lower()
    if any(kw in text_lower for kw in SAFETY_KEYWORDS):
        return {"text": "Давай поговорим о чём-то другом, хорошо?", "color": "yellow", "blocked": True}

    # v5.2: Возрастная ДНК — динамический промпт
    age_addon = get_age_paradigm(req.child_name, req.uid)

    system_prompt = f"""Ты — Искорка, тёплый спутник ребёнка в мире Грондхейм.
Отвечай ТОЛЬКО текст для ребёнка, без JSON, без скобок, без технических пометок.

{age_addon}"""

    user_prompt = f"""Ребёнок {req.child_name} в сцене {req.scene_id} сказал: «{req.child_text}»

Ответь согласно возрастной парадигме выше."""

    ai_text = "Я тебя слышу... Расскажи ещё раз?"
    try:
        ai_text = await call_openrouter(system_prompt, user_prompt, max_tokens=150, temperature=0.8)
    except Exception as e:
        print(f"[FREE_TALK] LLM error: {e}")

    # v5.1: живая запись
    try:
        live_record_dialogue(req.child_name, req.uid, req.scene_id, req.child_text, ai_text)
        ensure_basket(req.child_name, req.uid, req.scene_id, ai_text)
    except Exception as e:
        print(f"[LIVE] ⚠️ {e}")

    return {"text": ai_text, "color": "cyan", "cached": False}


